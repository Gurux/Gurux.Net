@if (Field.Address!.Server)
{
    var options = Field.Address.GetOptions(Properties.Resources.AllInterfaces, Properties.Resources.LoopbackOnly, Properties.Resources.CustomAddress, Properties.Resources.InterfaceAddress);
    var selected = options.FindIndex(option => option.Address == Field.Value);
    <select class="form-select mb-2" aria-label="@Properties.Resources.ListenAddress" value="@(selected >= 0 ? selected : options.Count - 1)" @onchange="SelectAddress">
        @for (int index = 0; index < options.Count; ++index)
        {
            <option value="@index">@options[index].Caption</option>
        }
    </select>
}
<input type="text" class="form-control" id="@Field.Id" @bind="Field.Value" @bind:event="oninput" />

@code {
    /// <summary>Gets or sets the staged host field containing both address modes.</summary>
    [Parameter, EditorRequired] public SettingsField Field { get; set; } = default!;

    /// <summary>Copies the selected bind address into the editable text field.</summary>
    /// <param name="args">The index of the selected bind choice.</param>
    private void SelectAddress(ChangeEventArgs args)
    {
        var options = Field.Address!.GetOptions(Properties.Resources.AllInterfaces, Properties.Resources.LoopbackOnly, Properties.Resources.CustomAddress, Properties.Resources.InterfaceAddress);
        if (int.TryParse(args.Value?.ToString(), out int selected) && selected >= 0 && selected < options.Count && options[selected].Address is string address)
        {
            Field.Value = address;
        }
    }
}
