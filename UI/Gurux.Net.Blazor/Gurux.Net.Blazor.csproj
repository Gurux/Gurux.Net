<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Gurux.Net.Blazor</PackageId>
    <Version Condition="'$(BUILD_BUILDNUMBER)' == ''">0.0.1-local</Version>
    <Version Condition="'$(BUILD_BUILDNUMBER)' != ''">$(BUILD_BUILDNUMBER)</Version>
    <Authors>Gurux Ltd</Authors><Company>Gurux Ltd</Company>
    <Description>Optional Blazor settings components for Gurux media libraries.</Description>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile></PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/HostAddressState.cs" Link="HostAddressState.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <PackageReference Include="Gurux.UI.Components" Version="4.0.2611.1801" />
    <ProjectReference Include="../../Development/Gurux.Net.csproj" />

  </ItemGroup>

  <PropertyGroup>
    <RepositoryUrl>https://github.com/Gurux/Gurux.Net</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>Net.png</PackageIcon>
    <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.*</GuruxCommonVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../Development/Net.png" Pack="true" PackagePath="/" />
    <None Remove="Tests/**;tests/**" />
    <Content Remove="Tests/**;tests/**" />
    <EmbeddedResource Remove="Tests/**;tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gurux.Common" Version="$(GuruxCommonVersion)" />
  </ItemGroup>
</Project>
