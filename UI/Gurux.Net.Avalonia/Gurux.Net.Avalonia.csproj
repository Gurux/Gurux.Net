<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
    <PackageId>Gurux.Net.Avalonia</PackageId><Version Condition="'$(BUILD_BUILDNUMBER)' == ''">0.0.1-local</Version><Version Condition="'$(BUILD_BUILDNUMBER)' != ''">$(BUILD_BUILDNUMBER)</Version>
    <Authors>Gurux Ltd</Authors><Company>Gurux Ltd</Company><Description>Avalonia settings editor for Gurux Net media.</Description><PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/HostAddressState.cs" Link="HostAddressState.cs" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <ProjectReference Include="../../Development/Gurux.Net.csproj" />

    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup>
    <RepositoryUrl>https://github.com/Gurux/Gurux.Net</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>Net.png</PackageIcon>
    <GuruxCommonVersion Condition="'$(GuruxCommonVersion)' == ''">9.0.2611.1601</GuruxCommonVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../Development/Net.png" Pack="true" PackagePath="/" />
    <None Remove="Tests/**;tests/**" />
    <Content Remove="Tests/**;tests/**" />
    <EmbeddedResource Remove="Tests/**;tests/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gurux.Common" Version="9.0.2611.1601" />
  </ItemGroup>
</Project>
